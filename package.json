{
  "name": "dpkit-mc",
  "version": "1.0.0",
  "description": "Check any datapack anywhere (CLI / CI / AI) with the Spyglass/DHP engine — plus per-version command syntax for humans and AI agents.",
  "type": "module",
  "main": "dist/api.js",
  "types": "dist/api.d.ts",
  "exports": {
    ".": {
      "types": "./dist/api.d.ts",
      "import": "./dist/api.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "bin": {
    "dpkit-mc": "dpkit.mjs",
    "dpkit-mcp": "dpkit-mcp.mjs"
  },
  "files": [
    "dist",
    "dpkit.mjs",
    "dpkit-mcp.mjs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "vendor/spyglass/BUILD.json",
    "vendor/spyglass/VENDORED.md",
    "!dist/**/*.map",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsc --emitDeclarationOnly && node scripts/build-bundle.mjs",
    "build:watch": "tsc --emitDeclarationOnly --watch",
    "test": "npm run build && node --test && node tests/mcp-smoke.mjs",
    "test:versions": "npm run build && node --test tests/multi-version.spec.mjs",
    "test:all": "npm test && npm run test:versions && npm run parity",
    "mcp": "node dist/mcp.js",
    "bench": "node tests/bench.mjs",
    "vendor": "node scripts/vendor-spyglass.mjs",
    "parity": "node tests/parity.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "minecraft",
    "datapack",
    "spyglass",
    "mcdoc",
    "lsp",
    "mcp",
    "linter"
  ],
  "author": "dpkit contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaiser-1871/Minecraft-Datapack-Kit.git"
  },
  "bugs": {
    "url": "https://github.com/kaiser-1871/Minecraft-Datapack-Kit/issues"
  },
  "homepage": "https://github.com/kaiser-1871/Minecraft-Datapack-Kit#readme",
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@spyglassmc/core": "file:vendor/spyglass/core",
    "@spyglassmc/java-edition": "file:vendor/spyglass/java-edition",
    "@spyglassmc/json": "file:vendor/spyglass/json",
    "@spyglassmc/language-server": "file:vendor/spyglass/language-server",
    "@spyglassmc/locales": "file:vendor/spyglass/locales",
    "@spyglassmc/mcdoc": "file:vendor/spyglass/mcdoc",
    "@spyglassmc/mcfunction": "file:vendor/spyglass/mcfunction",
    "@spyglassmc/nbt": "file:vendor/spyglass/nbt",
    "env-paths": "^2.2.1",
    "vscode-languageserver-textdocument": "^1.0.12",
    "zod": "^4.4.3",
    "@zip.js/zip.js": "^2.8.34"
  },
  "engines": {
    "node": ">=20"
  }
}
