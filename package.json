{
  "name": "dpkit",
  "version": "1.0.0",
  "description": "Datapack Kit — check a datapack with the Spyglass/DHP engine and teach its exact per-version command syntax.",
  "type": "module",
  "main": "dist/api.js",
  "types": "dist/api.d.ts",
  "bin": {
    "dpkit": "dpkit.mjs"
  },
  "files": [
    "dist",
    "dpkit.mjs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "vendor/spyglass/BUILD.json",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsc --emitDeclarationOnly && node scripts/build-bundle.mjs",
    "build:watch": "tsc --emitDeclarationOnly --watch",
    "test": "npm run build && node --test \"tests/**/*.test.mjs\" && node tests/mcp-smoke.mjs",
    "test:all": "npm test && npm run parity",
    "mcp": "node dist/mcp.js",
    "bench": "node tests/bench.mjs",
    "vendor": "node scripts/vendor-spyglass.mjs",
    "parity": "node tests/parity.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "minecraft",
    "datapack",
    "spyglass",
    "mcdoc",
    "lsp",
    "mcp",
    "linter"
  ],
  "author": "dpkit contributors",
  "license": "ISC",
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@spyglassmc/core": "file:vendor/spyglass/core",
    "@spyglassmc/java-edition": "file:vendor/spyglass/java-edition",
    "@spyglassmc/json": "file:vendor/spyglass/json",
    "@spyglassmc/language-server": "file:vendor/spyglass/language-server",
    "@spyglassmc/locales": "file:vendor/spyglass/locales",
    "@spyglassmc/mcdoc": "file:vendor/spyglass/mcdoc",
    "@spyglassmc/mcfunction": "file:vendor/spyglass/mcfunction",
    "@spyglassmc/nbt": "file:vendor/spyglass/nbt",
    "env-paths": "^2.2.1",
    "vscode-languageserver-textdocument": "^1.0.12",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=20"
  }
}
